# AI Service 개발 환경 설정

# 환경 설정
ENVIRONMENT=development
DEBUG=true
VERSION=1.0.0

# 서버 설정
HOST=0.0.0.0
PORT=8000

# JWT 설정
JWT_SECRET_KEY=dev-ai-service-jwt-secret-key-change-in-production-256-bits
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 키 설정 (개발용)
AI_SERVICE_API_KEY=dev-api-key-12345

# Redis 설정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=5

# OpenAI 설정 (개발용)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# AI 서비스 설정
MAX_FEEDBACK_LENGTH=2000
MAX_BATCH_SIZE=10
FEEDBACK_CACHE_TTL=300
ANALYSIS_CACHE_TTL=180

# Rate Limiting (개발용 - 관대함)
RATE_LIMIT_CALLS=1000
RATE_LIMIT_PERIOD=60

# 로깅 설정
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=

# 메트릭 설정
METRICS_ENABLED=true
METRICS_PORT=8001

# 성능 설정
WORKER_TIMEOUT=300
MAX_CONCURRENT_REQUESTS=100