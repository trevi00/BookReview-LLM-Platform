# AI Service 테스트 환경 설정

# 환경 설정
ENVIRONMENT=test
DEBUG=true
VERSION=1.0.0

# 서버 설정
HOST=127.0.0.1
PORT=8000

# JWT 설정 (테스트용)
JWT_SECRET_KEY=test-ai-service-jwt-secret-key-for-testing-only-256-bits
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# API 키 설정 (테스트용)
AI_SERVICE_API_KEY=test-api-key-12345

# Redis 설정 (테스트 DB 사용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=3

# OpenAI 설정 (테스트용 - Mock)
OPENAI_API_KEY=test-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.5
OPENAI_TIMEOUT=15
OPENAI_MAX_RETRIES=2

# AI 서비스 설정 (테스트용 - 작은 값)
MAX_FEEDBACK_LENGTH=1000
MAX_BATCH_SIZE=5
FEEDBACK_CACHE_TTL=60
ANALYSIS_CACHE_TTL=30

# Rate Limiting (테스트용 - 관대함)
RATE_LIMIT_CALLS=1000
RATE_LIMIT_PERIOD=60

# 로깅 설정
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_FILE=

# 메트릭 설정
METRICS_ENABLED=false
METRICS_PORT=8001

# 성능 설정
WORKER_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=50