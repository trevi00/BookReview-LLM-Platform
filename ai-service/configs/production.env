# AI Service 프로덕션 환경 설정
# 주의: 이 파일은 실제 프로덕션 배포 시 보안 설정으로 덮어써야 합니다.

# 환경 설정
ENVIRONMENT=production
DEBUG=false
VERSION=1.0.0

# 서버 설정
HOST=0.0.0.0
PORT=8000

# JWT 설정 (프로덕션용 - 실제 배포 시 변경 필수)
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_SECURE_256_BIT_KEY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API 키 설정 (프로덕션용 - 실제 배포 시 변경 필수)
AI_SERVICE_API_KEY=CHANGE_THIS_IN_PRODUCTION

# Redis 설정 (프로덕션용)
REDIS_HOST=redis-prod.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT=10

# OpenAI 설정 (프로덕션용 - 실제 API 키 필요)
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# AI 서비스 설정 (프로덕션 최적화)
MAX_FEEDBACK_LENGTH=5000
MAX_BATCH_SIZE=20
FEEDBACK_CACHE_TTL=7200
ANALYSIS_CACHE_TTL=3600

# Rate Limiting (프로덕션용 - 엄격)
RATE_LIMIT_CALLS=60
RATE_LIMIT_PERIOD=60

# 로깅 설정
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/ai-service/app.log

# 메트릭 설정
METRICS_ENABLED=true
METRICS_PORT=8001

# 모니터링 설정
SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# 성능 설정
WORKER_TIMEOUT=600
MAX_CONCURRENT_REQUESTS=200

# 보안 설정
ALLOWED_HOSTS=bookreview-ai.yourdomain.com,api.bookreview.com
CORS_ORIGINS=https://bookreview.com,https://www.bookreview.com